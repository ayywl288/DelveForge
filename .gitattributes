# 默认按文本处理，由 Git 自动判断是否转换换行符
* text=auto

# Maven Wrapper 与 Shell 脚本必须以 LF 保存，否则在 Windows 上无法执行
mvnw text eol=lf
*.sh text eol=lf
# 构建上下文按原始字节计算镜像标签，Windows 检出后也要使用 Linux 换行。
/runtime/workbench/** text eol=lf
/runtime/workbench/Initialize-Environment.ps1 text eol=crlf

# Windows 批处理脚本保留 CRLF
mvnw.cmd text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
