<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ayywl.delveforge</groupId>
        <artifactId>delveforge</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>delveforge-infrastructure</artifactId>
    <name>delveforge-infrastructure</name>
    <description>DeepSeek、Persistence、Git、Filesystem、Shell、Build / Test 等外部能力 Adapter</description>

    <dependencies>
        <!--
            Infrastructure 实现 Application 定义的 Outbound Port（RULE-ARCH-004）。
            domain 由 application 传递引入，此处仍显式声明，
            以保持与 ARCHITECTURE.md 记录的依赖关系一致。
        -->
        <dependency>
            <groupId>com.ayywl.delveforge</groupId>
            <artifactId>delveforge-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ayywl.delveforge</groupId>
            <artifactId>delveforge-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Persistence 技术栈只允许出现在 Infrastructure 边界内，
            不得泄漏到 Domain / Application（RULE-ARCH-002、RULE-ARCH-003）。
            版本见根 pom 的 mybatis-plus.version 与 Spring Boot BOM。
        -->

        <!-- SQLite JDBC 驱动 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <!-- MyBatis-Plus Spring Boot 集成，提供 SqlSessionFactory 等自动装配 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- Flyway schema migration，SQLite 支持内置于 flyway-core -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Infrastructure 测试需要真实启动 Spring 上下文以验证自动装配链路 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <rules>
                        <bannedDependencies>
                            <excludes>
                                <!-- Infrastructure 不得依赖 Composition Root -->
                                <exclude>com.ayywl.delveforge:delveforge-app</exclude>
                            </excludes>
                        </bannedDependencies>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
